load("@rules_python//python:py_library.bzl", "py_library")

py_library(
    name = "greeter",
    srcs = ["__init__.py"],
    # `import greeter` (the package is lib/greeter/)
    imports = [".."],
    visibility = ["//visibility:public"],
)

# Make the files available to doxygen
filegroup(
    name = "sources",
    srcs = glob(["*.py"]),
    visibility = ["//visibility:public"],
)
