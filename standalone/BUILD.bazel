load("@rules_oci//oci:defs.bzl", "oci_image", "oci_image_index", "oci_push", "oci_load")
load("@aspect_bazel_lib//lib:expand_template.bzl", "expand_template")
load("@rules_pkg//pkg:mappings.bzl", "pkg_files", "strip_prefix")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("//:bzl/naming_convention.bzl", "naming_convention")
load("//:bzl/variables.bzl", "IMAGE_NAME")
load("//:bzl/transition.bzl", "multi_arch")
load("//:bzl/variables.bzl", "PROJECT_NAME")

package(default_visibility = ["//visibility:public"])

# Exposes the value of the project's naming convention and
# some compilation information to the package naming.
naming_convention(
    name = "naming",

    # We make the product name a variable rather than put it in every rule.
    # This technique can be useful if you need to create packages in many
    # different formats but have not decided on the final naming yet. You
    # can use a placeholder and change it on one location.
    product_name = PROJECT_NAME,
)

# Release tarball: the Bazel-built extensions with the Python sources, to be
# used with the pinned dependencies of requirements_lock.txt (see the
# README.md inside). The full runtime (PyTorch + CUDA wheels, ~7 GB) is
# shipped in the container image instead: GitHub release assets are limited
# to 2 GB.
pkg_files(
    name = "site_packages",
    srcs = [
        "//src:_droid_backends.so",
        "//src:droid_backends.py",
        "@lietorch//:lietorch_backends.so",
    ],
    prefix = "site-packages",
)

pkg_files(
    name = "lietorch",
    srcs = ["@lietorch//:python_srcs"],
    prefix = "site-packages",
    strip_prefix = strip_prefix.from_pkg(),
)

pkg_files(
    name = "torch_scatter",
    srcs = ["//third_party/torch_scatter:sources"],
    prefix = "site-packages",
    strip_prefix = strip_prefix.from_pkg(),
)

pkg_files(
    name = "droid_slam",
    srcs = [
        "//:calib",
        "//:scripts",
        "//droid_slam:sources",
    ],
    strip_prefix = strip_prefix.from_root(),
)

pkg_files(
    name = "licenses",
    srcs = [
        "//:LICENSE",
        "//:UPSTREAM.md",
        "//:requirements_lock.txt",
    ],
)

pkg_files(
    name = "third_party_licenses",
    srcs = ["@lietorch//:LICENSE"],
    renames = {"@lietorch//:LICENSE": "licenses/lietorch.LICENSE"},
)

pkg_tar(
    name = "tar",
    srcs = [
        "README.md",
        ":droid_slam",
        ":licenses",
        ":lietorch",
        ":site_packages",
        ":third_party_licenses",
        ":torch_scatter",
    ],
    extension = "tar.gz",
    package_dir = PROJECT_NAME,
    package_file_name = select({
        "//:is_release": "{product_name}_{target_gnu_system}_{compilation_mode}__v{version}.tar.gz",
        "//:is_wip": "{product_name}_{target_gnu_system}_{compilation_mode}__sha256-{commit_sha}.tar.gz",
        "//conditions:default": "{product_name}_{target_gnu_system}_{compilation_mode}.tar.gz",
    }),
    package_variables = ":naming",
)

# Image layer: //:demo with its runfiles (hermetic interpreter, PyTorch and
# the CUDA libraries). Built only when needed (`manual`): it is large.
pkg_tar(
    name = "image_layer",
    srcs = ["//:demo"],
    include_runfiles = True,
    tags = ["manual"],
)

pkg_tar(
    name = "image_licenses",
    srcs = [
        ":licenses",
        ":third_party_licenses",
    ],
    package_dir = "/licenses",
)

# Making image
# The binary needs glibc and libstdc++ from the base image; the NVIDIA
# container toolkit (`docker run --gpus all`) mounts the driver, the CUDA
# libraries come with the PyTorch wheels.

# Use the value of --embed_label under --stamp, otherwise use a deterministic constant
# value to ensure cache hits for actions that depend on this.
expand_template(
    name = "image-annotations",
    out = "labels.txt",
    stamp_substitutions = {
        "0.0.0": "{{STABLE_SEMANTIC_VERSION}}",
        "commit-sha256": "{{STABLE_GIT_COMMIT}}",
    },
    template = [
        "org.opencontainers.image.title={}".format(PROJECT_NAME),
        "org.opencontainers.image.version=0.0.0",
        "org.opencontainers.image.revision=commit-sha256",
    ],
)

oci_image(
    name = "image",
    base = "@docker_lib_ubuntu",
    cmd = ["--help"],
    entrypoint = ["/demo"],
    env = {
        "NVIDIA_DRIVER_CAPABILITIES": "compute,utility",
        "NVIDIA_VISIBLE_DEVICES": "all",
    },
    labels = ":image-annotations",
    tags = ["manual"],
    tars = [
        ":image_layer",
        ":image_licenses",
    ],
    # Upstream relative paths (--calib=calib/eth.txt) resolve in the runfiles.
    workdir = "/demo.runfiles/_main",
)

multi_arch(
    name = "images",
    image = ":image",
    platforms = ["//bzl/platforms:linux-x86_64"],
    tags = ["manual"],
)

oci_image_index(
    name = "multiarch_image",
    images = [
        ":images"
    ],
    tags = ["manual"],
)

# NOTE: STABLE_SEMANTIC_VERSION is defined in tools/workspace_status.sh
expand_template(
    name = "release-tags",
    out = "release-tags.txt",
    stamp_substitutions = {
        "0.0.0": "{{STABLE_SEMANTIC_VERSION}}",
    },
    template = [
        "v0.0.0",
    ]
)
# NOTE: STABLE_GIT_COMMIT_SHORT is defined in tools/workspace_status.sh
expand_template(
    name = "wip-tags",
    out = "wip-tags.txt",
    stamp_substitutions = {
        "sha256": "{{STABLE_GIT_COMMIT_SHORT}}",
    },
    template = [
        "sha256",
    ]
)
# NOTE: STABLE_GIT_COMMIT_SHORT is defined in tools/workspace_status.sh
expand_template(
    name = "dirty-tags",
    out = "dirty-tags.txt",
    stamp_substitutions = {
        "sha256": "{{STABLE_GIT_COMMIT_SHORT}}",
    },
    template = [
        "sha256",
        "latest",
    ]
)
# NOTE: STABLE_IMAGE_REGISTRY is defined in tools/workspace_status.sh
expand_template(
    name = "repositories",
    out = "repositories.txt",
    stamp_substitutions = {
        "repository-url/user": "{{STABLE_IMAGE_REGISTRY}}",
        "image": IMAGE_NAME,
    },
    template = ["repository-url/user/image"],
)

oci_push(
    name = "push_image",
    image = ":multiarch_image",
    remote_tags = select({
        "//:is_release": ":release-tags",
        "//:is_wip": ":wip-tags",
        "//conditions:default": ":dirty-tags",
    }),
    repository_file = ":repositories",
    tags = ["manual"],
)

# Use with 'bazel run' to load the oci image into a container runtime.
# The image is designated using `repo_tags` attribute.
oci_load(
    name = "load_image",
    image = ":multiarch_image",
    format = "oci",
    repo_tags = select({
        "//:is_release": ":release-tags",
        "//:is_wip": ":wip-tags",
        "//conditions:default": ":dirty-tags",
    }),
    tags = ["manual"],
)

# Single-architecture image for the host platform, loaded by
# //integration:standalone_image_test.
oci_load(
    name = "load_host_image",
    image = ":image",
    repo_tags = ["droid-slam:integration-test"],
    tags = ["manual"],
)

filegroup(
    name = "host_image.tar",
    srcs = [":load_host_image"],
    output_group = "tarball",
    tags = ["manual"],
)
