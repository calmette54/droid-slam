load("@pypi//:requirements.bzl", "requirement")
load("@rules_python//python:py_test.bzl", "py_test")

# bazelisk test --config=gpu //test/gpu/...

py_test(
    name = "droid_backends_test",
    size = "small",
    srcs = ["droid_backends_test.py"],
    tags = ["requires-gpu"],
    visibility = ["//test/lint:__pkg__"],
    deps = [
        "//droid_slam",
        requirement("pytest"),
    ],
)

# End to end: DROID_IMAGEDIR (e.g. data/sfm_bench/rgb from
# tools/download_sample_data.sh) must be an absolute path; DROID_CALIB is a file
# in calib/ (default eth.txt). The weights are @droid_weights unless DROID_WEIGHTS
# (an absolute path) overrides them.
py_test(
    name = "demo_smoke_test",
    size = "large",
    srcs = ["demo_smoke_test.py"],
    data = [
        "//:calib",
        "//:demo",
        "@droid_weights//file",
    ],
    env = {"DROID_DEFAULT_WEIGHTS": "$(rlocationpath @droid_weights//file)"},
    env_inherit = [
        "DROID_CALIB",
        "DROID_IMAGEDIR",
        "DROID_WEIGHTS",
    ],
    # "manual": needs the weights and a dataset, so only when asked for.
    tags = [
        "local",
        "manual",
        "requires-gpu",
    ],
    visibility = ["//test/lint:__pkg__"],
    deps = [
        "@rules_python//python/runfiles",
        requirement("pytest"),
        requirement("torch"),
    ],
)

# Accuracy: EuRoC MH_03_medium from the sample data against the paper's ATE.
# DROID_SAMPLE_DIR is the absolute path of data/ (//tools:download_dataset -- sample).
py_test(
    name = "euroc_mh03_ate_test",
    size = "large",
    srcs = ["euroc_mh03_ate_test.py"],
    data = [
        "//benchmark:accuracy",
        "//data:euroc_groundtruth",
        "//evaluation_scripts:test_euroc",
        "@droid_weights//file",
    ],
    env = {"DROID_DEFAULT_WEIGHTS": "$(rlocationpath @droid_weights//file)"},
    env_inherit = ["DROID_SAMPLE_DIR"],
    tags = [
        "local",
        "manual",
        "requires-gpu",
    ],
    visibility = ["//test/lint:__pkg__"],
    deps = [
        "//benchmark:accuracy_lib",
        "@rules_python//python/runfiles",
        requirement("pytest"),
        requirement("torch"),
    ],
)
