# https://clang.llvm.org/extra/clang-tidy/
# Run with `bazelisk lint //...`; //test/lint runs it as a test.
Checks: >
  bugprone-*,
  cert-*,
  clang-analyzer-*,
  concurrency-*,
  cppcoreguidelines-*,
  misc-*,
  modernize-*,
  performance-*,
  portability-*,
  readability-*,
  -cert-err58-cpp,
  -clang-diagnostic-builtin-macro-redefined,
  -cppcoreguidelines-avoid-magic-numbers,
  -cppcoreguidelines-non-private-member-variables-in-classes,
  -misc-include-cleaner,
  -misc-non-private-member-variables-in-classes,
  -misc-use-anonymous-namespace,
  -modernize-use-trailing-return-type,
  -readability-identifier-length,
  -readability-magic-numbers
# Disabled above:
# - cert-err58-cpp, misc-use-anonymous-namespace: fire on the static
#   registrations generated by test and benchmark macros.
# - clang-diagnostic-builtin-macro-redefined: Bazel redefines __DATE__ and
#   friends for reproducible builds.
CheckOptions:
  cppcoreguidelines-avoid-do-while.IgnoreMacros: true
WarningsAsErrors: "*"
